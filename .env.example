# Frontend -> Backend Proxy (leave empty on Vercel to run the built-in edge engine)
FASTAPI_URL=http://localhost:8002

# Optional OpenAI API key for response polishing (falls back to deterministic engine when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional shared secret for verifying POST /api/v1/webhooks/whatsapp (header: X-Relay-Webhook-Secret)
WHATSAPP_WEBHOOK_SECRET=
